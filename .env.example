# Environment variables
#
# Copy to `.env` for local overrides. Never commit real secrets.

# Public AdSense publisher id. Left empty by default so local and PR builds
# stay ad-free; set it in the GitHub Pages environment to enable ads.
PUBLIC_ADSENSE_CLIENT=
# Ad unit slot id, once you have one created in the AdSense dashboard.
PUBLIC_ADSENSE_SLOT=

# Optional: build with the committed data snapshot instead of hitting the
# live Google Sheet. Useful for offline work or reproducing a CI failure.
# OFFLINE_DATA=false