---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, socials } from '../data/profile';

const channels = [
  {
    label: 'Email',
    value: profile.email,
    href: `mailto:${profile.email}`,
    note: 'Best for anything with detail. I reply within a day or two.',
    primary: true,
  },
  {
    label: 'WhatsApp',
    value: profile.whatsapp,
    href: profile.whatsappHref,
    note: 'Quick questions and scheduling.',
    primary: false,
  },
  {
    label: 'LinkedIn',
    value: 'Muhammad Alfaz',
    href: 'https://www.linkedin.com/in/muhammad-alfaz-74a173208',
    note: 'Professional enquiries and referrals.',
    primary: false,
  },
];
---

<BaseLayout
  title={`Contact | ${profile.name}`}
  description={`Get in touch with ${profile.name} about freelance work, collaborations, or a question about a project.`}
>
  <section class="section shell">
    <div class="contact">
      <div class="contact__intro">
        <p class="eyebrow" data-reveal>Contact</p>
        <h1 class="contact__title" data-reveal>Let's talk.</h1>
        <p class="lede" data-reveal>
          I'm open to freelance projects and collaborations. If you have a web or
          product problem, tell me about it. A rough description of what you need
          is more useful than a polished brief.
        </p>

        <ul class="contact__links" data-reveal>
          {
            socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener noreferrer">
                  <span class="contact__link-label">{social.label}</span>
                  <span class="contact__link-handle">{social.handle}</span>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M6 3h7v7M13 3 3.5 12.5"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="contact__channels">
        {
          channels.map((channel, index) => (
            <a
              class:list={['channel', { 'channel--primary': channel.primary }]}
              href={channel.href}
              target={channel.href.startsWith('mailto:') ? undefined : '_blank'}
              rel="noopener noreferrer"
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <span class="channel__label">{channel.label}</span>
              <span class="channel__value">{channel.value}</span>
              <span class="channel__note">{channel.note}</span>
              <span class="channel__cta">
                Open
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M3 8h10m0 0-4-4m4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.85fr);
    gap: var(--space-8);
    align-items: start;
  }

  .contact__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .contact__title {
    font-size: var(--text-4xl);
  }

  .contact__links {
    display: grid;
    gap: var(--space-1);
    inline-size: 100%;
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-3);
  }

  .contact__links a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-hairline);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .contact__links a:hover {
    color: var(--paper);
  }

  .contact__link-label {
    font-size: var(--text-sm);
    min-inline-size: 80px;
  }

  .contact__link-handle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--grey-50);
  }

  .contact__links svg {
    inline-size: 14px;
    block-size: 14px;
    align-self: center;
    color: var(--grey-50);
  }

  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .channel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-hairline);
    border-radius: var(--radius);
    background-color: var(--surface-card);
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  /* Wipe fill on hover, matching the button treatment. */
  .channel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--paper);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .channel:hover {
    color: var(--ink);
    border-color: var(--paper);
    transform: translateY(-2px);
  }

  .channel:hover::before {
    transform: scaleY(1);
  }

  .channel__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey-50);
    transition: color var(--duration-base) var(--ease-out);
  }

  .channel:hover .channel__label,
  .channel:hover .channel__note {
    color: var(--ink);
    opacity: 0.6;
  }

  .channel__value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .channel__note {
    font-size: var(--text-sm);
    color: var(--grey-70);
    transition: color var(--duration-base) var(--ease-out);
  }

  .channel__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .channel__cta svg {
    inline-size: 14px;
    block-size: 14px;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .channel:hover .channel__cta svg {
    transform: translateX(3px);
  }

  .channel--primary {
    border-color: var(--grey-30);
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel,
    .channel::before,
    .channel:hover {
      transform: none;
      transition: none;
    }
  }
</style>