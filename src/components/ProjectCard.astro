---
/**
 * Project card.
 *
 * Interaction: the whole card is a link, and the image panel is duplicated and
 * translated on hover so the screenshot appears to slide within a fixed frame.
 * Purely CSS, so it survives view transitions without re-initialisation.
 */
import type { Project } from '../lib/project-schema';

interface Props {
  project: Project;
  /** Staggers the entrance animation in the grid. */
  index?: number;
}

const { project, index = 0 } = Astro.props;

const links = [
  project.homepage ? { href: project.homepage, label: 'Live site', icon: 'globe' } : null,
  project.repo ? { href: project.repo, label: 'Source code', icon: 'code' } : null,
  project.androidDownload
    ? { href: project.androidDownload, label: 'Android build', icon: 'android' }
    : null,
  project.iosDownload ? { href: project.iosDownload, label: 'iOS build', icon: 'apple' } : null,
].filter((link) => link !== null);
---

<article class="card" data-reveal style={`--reveal-delay: ${Math.min(index, 8) * 45}ms`}>
  <a class="card__link" href={`/projects/${project.slug}`}>
    <div class="card__media">
      {
        project.image ? (
          /*
           * One image, one transform. An earlier version stacked two copies and
           * slid the top one down, which only moved the visible band and looked
           * like a rendering glitch. Scaling a single layer moves the whole
           * frame evenly, which is what the zoom-out needs.
           *
           * Start slightly scaled up (1.08) so there is headroom to zoom out to
           * 1.0. Zooming out rather than in means the screenshot never crops
           * differently between hover states.
           */
          <img class="card__img" src={project.image} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class="card__placeholder" aria-hidden="true">
            <span>{project.name.slice(0, 2)}</span>
          </div>
        )
      }

      <div class="card__badges">
        <span class:list={['badge', project.visibility === 'public' ? 'badge--open' : 'badge--closed']}>
          {project.visibility === 'public' ? 'Open source' : 'Client work'}
        </span>
        {project.featured && <span class="badge badge--featured">Featured</span>}
      </div>
    </div>

    <div class="card__body">
      <div class="card__heading">
        <h3 class="card__title">{project.name}</h3>
        {project.year && <span class="card__year">{project.year}</span>}
      </div>

      {project.tagline && <p class="card__text">{project.tagline}</p>}

      {
        project.tools.length > 0 && (
          <ul class="card__tools" aria-label="Technologies used">
            {project.tools.slice(0, 4).map((tool) => (
              <li class="tag">{tool}</li>
            ))}
            {project.tools.length > 4 && <li class="tag tag--more">+{project.tools.length - 4}</li>}
          </ul>
        )
      }
    </div>
  </a>

  {
    links.length > 0 && (
      <div class="card__actions">
        {links.map((link) => (
          <a
            class="card__action"
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.name}, ${link.label}`}
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              {link.icon === 'globe' && (
                <>
                  <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.25" />
                  <path
                    d="M1.75 8h12.5M8 1.75c1.6 1.8 2.5 4 2.5 6.25S9.6 12.45 8 14.25C6.4 12.45 5.5 10.25 5.5 8S6.4 3.55 8 1.75Z"
                    stroke="currentColor"
                    stroke-width="1.25"
                  />
                </>
              )}
              {link.icon === 'code' && (
                <path
                  d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5"
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              )}
              {link.icon === 'android' && (
                <path
                  d="M4 6.5h8v6.25a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6.5Zm0 0a4 4 0 0 1 8 0M5.5 4.75l-.75-1.5m6 1.5.75-1.5"
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              )}
              {link.icon === 'apple' && (
                <path
                  d="M11.5 8.5c0-1.4 1.1-2 1.2-2.1-.6-.9-1.6-1-2-1-.9-.1-1.7.5-2.1.5-.4 0-1.1-.5-1.8-.5C5.9 5.4 5 6.1 4.6 7c-.9 1.6-.2 3.9.6 5.1.4.6.9 1.2 1.5 1.2.6 0 .8-.4 1.6-.4.7 0 1 .4 1.6.4.7 0 1.1-.6 1.5-1.2.5-.6.7-1.3.7-1.3s-1.5-.6-1.6-2.4ZM10 4.4c.3-.4.5-1 .5-1.6-.5 0-1.2.4-1.5.8-.3.4-.6 1-.5 1.5.6.1 1.2-.3 1.5-.7Z"
                  fill="currentColor"
                />
              )}
            </svg>
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--border-hairline);
    border-radius: var(--radius);
    /* Solid, not translucent: the canvas is fixed behind the page, so an alpha
       card would let the network drift under the text. */
    background-color: var(--surface-card);
    overflow: hidden;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .card:hover {
    border-color: var(--grey-30);
    background-color: var(--surface-card-hover);
    transform: translateY(-3px);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    /* Stretches the link over the whole card so the entire surface is clickable. */
    position: relative;
  }

  /* Keeps the separate action links above the stretched card link. */
  .card:has(.card__actions) .card__link {
    padding-block-end: 0;
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--ink-2);
    border-block-end: var(--border-hairline);
    /*
     * Containment hint: the image only scales, so the browser can composite it
     * on its own layer instead of repainting the card every frame.
     */
    contain: paint;
  }

  .card__img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    /*
     * Resting state is scaled up and dimmed; hover relaxes both. Scaling the
     * single layer is what makes the whole frame move evenly.
     */
    transform: scale(1.08);
    opacity: 0.82;
    transition:
      transform 620ms var(--ease-out),
      opacity 420ms var(--ease-out),
      filter 620ms var(--ease-out);
  }

  .card:hover .card__img,
  .card:focus-within .card__img {
    transform: scale(1);
    opacity: 1;
    filter: grayscale(1) contrast(1.12) brightness(1.1);
  }

  .card__placeholder {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 10px,
        var(--surface-subtle) 10px 11px
      ),
      var(--ink-2);
  }

  .card__placeholder span {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 600;
    color: var(--grey-15);
    letter-spacing: -0.03em;
  }

  .card__badges {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-start: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .badge {
    padding: 0.2em 0.6em;
    border-radius: var(--radius-full);
    /* Opaque so the badge stays readable over any screenshot. */
    background-color: var(--ink-1);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey-90);
  }

  .badge--featured {
    background-color: var(--paper);
    color: var(--ink);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .card__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .card__title {
    font-size: var(--text-lg);
  }

  .card__year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--grey-50);
    flex: none;
  }

  .card__text {
    font-size: var(--text-sm);
    color: var(--paper-dim);
    /* Clamp so cards stay the same height regardless of description length. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-block-start: auto;
  }

  .tag--more {
    color: var(--grey-50);
  }

  .card__actions {
    display: flex;
    gap: var(--space-2);
    padding: 0 var(--space-5) var(--space-5);
  }

  .card__action {
    display: grid;
    place-items: center;
    inline-size: 34px;
    block-size: 34px;
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    color: var(--grey-70);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .card__action svg {
    inline-size: 15px;
    block-size: 15px;
  }

  .card__action:hover {
    background-color: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover,
    .card__img,
    .card:hover .card__img {
      transform: none;
      transition: none;
    }
  }
</style>